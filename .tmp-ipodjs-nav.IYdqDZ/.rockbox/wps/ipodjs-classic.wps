# Stock-style iPod Classic 6G WPS using Rockbox's playback lifecycle.
# All chrome is drawn; no iPone/purple bitmap assets are used.
%wd
%Fl(2,14-Adobe-Helvetica-Bold.fnt)
%Cl(15,42,128,128,c,c,1)

# Always-rendered player base. Dynamic overlays are evaluated after it.
%V(0,0,320,240,-)%Vf(000000)%Vb(FFFFFF)
%dr(0,0,320,240,FFFFFF)

%V(0,0,320,21,2)%Vf(000000)%Vb(D9DCE0)
%dr(0,0,320,10,FBFCFD,D9DCE0)
%dr(0,10,320,10,D9DCE0,AEB3B9)
%dr(0,20,320,1,7D858E)
%dr(282,5,25,11,FFFFFF,747B83)%dr(284,7,21,7,63A94B)%dr(307,8,3,5,747B83)
%V(6,3,240,16,2)%Vf(000000)%Vb(D9DCE0)%alNow Playing

%V(15,42,128,128,2)%Vf(777777)%Vb(EEEEEE)
%?C(1)<%Cd(1)|%dr(0,0,128,128,F8F8F8,E2E2E2)%dr(0,0,128,1,B6B6B6)%dr(0,127,128,1,B6B6B6)%acNo Artwork>
%V(157,48,151,24,2)%Vf(000000)%Vb(FFFFFF)
%s%al%?it<%it|%fn>
%V(157,78,151,20,2)%Vf(333333)%Vb(FFFFFF)
%s%al%?ia<%ia|Unknown Artist>
%V(157,101,151,20,2)%Vf(666666)%Vb(FFFFFF)
%s%al%?id<%id|Unknown Album>
%V(157,134,151,20,2)%Vf(555555)%Vb(FFFFFF)
%al%pp of %pe

# Playback scrubber and temporary volume replacement occupy identical pixels.
%?mv(1.5)<%Vd(VolumeBar)%Vd(VolumeLabel)|%Vd(Progress)%Vd(Time)>
%Vl(Progress,15,198,290,8,-)%Vf(287BC1)%Vb(D4D4D4)
%pb(0,0,290,8,noborder)
%Vl(Time,15,211,290,19,2)%Vf(555555)%Vb(FFFFFF)
%al%pc%ac%?mp<Stopped|Playing|Paused|Fast Forward|Rewind>%ar-%pr
%Vl(VolumeBar,15,198,290,8,-)%Vf(287BC1)%Vb(D4D4D4)
%pv(0,0,290,8,noborder)
%Vl(VolumeLabel,15,211,290,19,2)%Vf(555555)%Vb(FFFFFF)
%al-%acVolume%ar+

# Hold is drawn last and covers the player, matching native iPodJS geometry.
%?mh<%Vd(LockBg)%Vd(LockHeader)%Vd(LockHeaderTitle)%Vd(LockArt)%Vd(LockTitle)%Vd(LockArtist)%Vd(LockState)%Vd(LockMessage)|>
%Vl(LockBg,0,0,320,240,-)%Vf(FFFFFF)%Vb(22242A)
%dr(0,0,320,240,22242A)
%Vl(LockHeader,0,0,320,21,2)%Vf(000000)%Vb(D9DCE0)
%dr(0,0,320,10,FBFCFD,D9DCE0)%dr(0,10,320,10,D9DCE0,AEB3B9)%dr(0,20,320,1,7D858E)
%dr(282,5,25,11,FFFFFF,747B83)%dr(284,7,21,7,63A94B)%dr(307,8,3,5,747B83)
%Vl(LockHeaderTitle,6,3,240,16,2)%Vf(000000)%Vb(D9DCE0)%alHOLD
%Vl(LockArt,32,54,96,96,2)%Vf(777777)%Vb(22242A)
%Cl(0,0,96,96,c,c,2)%?C(2)<%Cd(2)|%dr(0,0,96,96,353840)%acNo Artwork>
%Vl(LockTitle,150,78,142,20,2)%Vf(FFFFFF)%Vb(22242A)
%s%al%?it<%it|%fn>
%Vl(LockArtist,150,100,142,20,2)%Vf(BEC2C8)%Vb(22242A)
%s%al%?ia<%ia|Unknown Artist>
%Vl(LockState,150,140,142,20,2)%Vf(BEC2C8)%Vb(22242A)
%al%?mp<Stopped|Hold|Paused|Hold|Hold>
%Vl(LockMessage,150,160,142,20,2)%Vf(BEC2C8)%Vb(22242A)
%alControls Locked
