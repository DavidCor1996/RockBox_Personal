# iPodJS Classic WPS lifecycle host.
#
# The native iPodJS compositor owns every visible RetailOS surface. This skin
# carries no legacy 5G-derived chrome; it keeps Rockbox's album-art declaration
# so playback remains the sole owner of album-art allocation and decoding.
%wd
%Fl(2,14-Adobe-Helvetica-Bold.fnt)

%V(0,0,320,240,-)%Vf(FFFFFF)%Vb(FFFFFF)
%Vs(none)

# Declare the playback-owned slot in a never-enabled viewport. Skin refreshes
# must not erase or flatten the cached native frame painted above this host.
%Vl(art,15,34,128,128,-)
%Cl(0,0,128,128,c,c,1)
