# Stock iPod Classic 6G Now Playing screen on Rockbox's WPS lifecycle.
# Chrome and indicators are verified Apple bitmaps; only the flat body fill
# and text are rendered by the skin engine.
%wd
%Fl(2,14-Adobe-Helvetica-Bold.fnt)

# Semantic body color is resolved by the iPodJS palette at render time.
%V(0,0,320,240,-)%Vf(F7F7F7)%Vb(F7F7F7)
%dr(0,0,320,240,F7F7F7)

# Apple status bar, playback/Hold state, and sparse documented battery states.
%V(0,0,320,24,2)%Vf(080808)%Vb(E6E9EC)
%xl(H,/.rockbox/ipodjs/apple/status-header.apple.320x24x24.bmp,0,0)
%xl(B,/.rockbox/ipodjs/apple/status-battery.apple.26x65x24.bmp,289,5,5)
%xl(P,/.rockbox/ipodjs/apple/status-playback.apple.20x32x24.bmp,270,4,2)
%xl(L,/.rockbox/ipodjs/apple/status-hold.apple.12x15x24.bmp,274,4)
%?St(ui engine dark mode)<%dr(0,0,320,24,E6E9EC)|%?mh<%xd(H)%xd(L)|%xd(H)%?mp<|%xd(Pa)|%xd(Pb)|%xd(Pa)|%xd(Pa)|||%xd(Pa)|%xd(Pb)>>>
%?St(ui engine dark mode)<|%?bp<%?if(%bl, >=, 100)<%xd(Be)|%xd(Bd)>|%?if(%bl, <=, 20)<%xd(Ba)|%?if(%bl, <, 80)<%xd(Bb)|%xd(Bc)>>>>
%V(6,3,244,18,2)%Vf(080808)%Vb(DDE2E7)
%Vs(none)%alNow Playing
%V(252,3,27,18,2)%Vf(2A8ADD)%Vb(DDE2E7)
%Vs(none)%?St(ui engine dark mode)<%ar%?mh<H|%?mp<|P|II|P|R||||P|II>>|>
%V(282,3,32,18,2)%Vf(080808)%Vb(DDE2E7)
%Vs(none)%?St(ui engine dark mode)<%ar%bl|>

# Stock shuffle/repeat glyphs sit directly below the status bar.
%V(258,24,62,20,2)%Vf(2A8ADD)%Vb(F7F7F7)
%xl(S,/.rockbox/ipodjs/apple/status-shuffle.apple.21x19x24.bmp,6,0)
%xl(R,/.rockbox/ipodjs/apple/status-repeat.apple.21x38x24.bmp,32,0,2)
%dr(0,0,62,20,F7F7F7)%?St(ui engine dark mode)<%?ps<S|>%?mm<|R|1|R|R>|%?ps<%xd(S)|>%?mm<|%xd(Ra)|%xd(Rb)|%xd(Ra)|%xd(Ra)>>

# Album artwork and Apple's stock music-note fallback.
%V(15,34,128,128,-)%Vf(777777)%Vb(F7F7F7)
%xl(D,/.rockbox/ipodjs/default_album_artwork.128x128x24.bmp,0,0)
%xl(d,/.rockbox/ipodjs/default_album_artwork.128x128x24-dark.bmp,0,0)
%Cl(0,0,128,128,c,c,1)
%dr(0,0,128,128,F7F7F7)%?C(1)<%Cd(1)|%?St(ui engine dark mode)<%xd(d)|%xd(D)>>

# Stock metadata hierarchy: title, artist, album, then playlist position.
%V(157,58,153,20,2)%Vf(080808)%Vb(F7F7F7)
%dr(0,0,153,20,F7F7F7)%Vs(none)%s%al%?it<%it|%fn>
%V(157,81,153,18,2)%Vf(393939)%Vb(F7F7F7)
%dr(0,0,153,18,F7F7F7)%Vs(none)%s%al%?ia<%ia|Unknown Artist>
%V(157,102,153,18,2)%Vf(5A5A5A)%Vb(F7F7F7)
%dr(0,0,153,18,F7F7F7)%Vs(none)%s%al%?id<%id|Unknown Album>
%V(157,130,153,18,2)%Vf(5A5A5A)%Vb(F7F7F7)
%dr(0,0,153,18,F7F7F7)%Vs(none)%al%pp of %pe

# The iPodJS WPS renderer draws the selected accent inside a rounded track
# and reasserts the frame after the fill, including at 100 percent.
%V(60,198,200,22,-)%Vf(2A8ADD)%Vb(F7F7F7)
%?mv(1.5)<%pv(0,0,200,22,noborder)|%pb(0,0,200,22,noborder)>

%V(8,201,46,18,2)%Vf(1C1C1D)%Vb(F7F7F7)
%dr(0,0,46,18,F7F7F7)%Vs(none)%al%?mv(1.5)<-|%pc>
%V(266,201,46,18,2)%Vf(1C1C1D)%Vb(F7F7F7)
%dr(0,0,46,18,F7F7F7)%Vs(none)%ar%?mv(1.5)<+|-%pr>
