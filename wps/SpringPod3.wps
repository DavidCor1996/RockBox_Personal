# Theme: SpringPod3
# iOS 3-style Now Playing skin for iPod Video 5G / 5.5G.
%wd

%Fl(2,14-Adobe-Helvetica-Bold.fnt)
%Fl(3,16-Adobe-Helvetica-Bold.fnt)
%Fl(4,35-Adobe-Helvetica-Bold.fnt)
%Fl(5,18-Adobe-Helvetica-Bold.fnt)

%xl(WpsBg,WpsBackdrop.bmp)
%xl(Lockscreen,Wallpaper.bmp)
%xl(ChargeWallpaper,ChargeWallpaper.bmp)
%xl(PlayerFallback,PlayerFallback.bmp,28,64)
%xl(B,Battery.bmp,0,0,24)
%xl(P,Playing Status.bmp,0,0,4)
%xl(PlayIcon,PlayStatus.bmp,9)
%xl(ShuffleIcon,ShuffleStatusSmall.bmp,2)
%xl(RepeatIcon,RepeatStatusSmallLarge.bmp,5)
%xl(LockPlayIcon,NotifPlayIcon.bmp,2)
%xl(NotificationMusic,NotifMusic.bmp,14,12)
%xl(VolumeBackdrop,VolumeBackdrop.bmp)
%xl(VolumeIcons,VolumePromptIcons.bmp,4)
%xl(VolumeSliderBackdrop,VolumeSliderBackdropPurple.bmp)
%xl(VolumeSliderPurple,VolumeSliderPurple.bmp)
%xl(VolumeSliderEndPurple,VolumeSliderEndPurple.bmp)

%Cl(28,64,128,128,c,c,1)

%V(0,0,-,-,-)
%?mh<%?bp<%xd(ChargeWallpaper)|%xd(Lockscreen)>|%xd(WpsBg)>
%?mh<%Vd(LockStatus)%Vd(LockClock)%Vd(LockDate)%?mp<|%Vd(LockCard)>|%Vd(Status)%Vd(Nav)%Vd(AlbumArt)%Vd(Title)%Vd(Artist)%Vd(Album)%Vd(Playback)%Vd(Progress)%?mv(1.2)<%Vd(VolumeCard)%Vd(VolumeIcon)%Vd(VolumeSlider)|>>

%Vl(Status,8,4,80,12,2)%Vf(FFFFFF)%aliPod
%Vl(Status,135,4,50,12,2)%Vf(FFFFFF)%ac%cl:%cM
%Vl(Status,244,3,16,13,-)%?mp<|%xd(Pa)|%xd(Pb)|%xd(Pc)|%xd(Pd)|||%xd(Pa)|%xd(Pb)>
%Vl(Status,287,4,25,11,-)
%?bp<%?bc<%t(1.0)%xd(Ba);%t(1.0)%xd(Bb)|%xd(Bc)>|%?bl<%xd(Bd)|%xd(Bd)|%xd(Be)|%xd(Bf)|%xd(Bg)|%xd(Bh)|%xd(Bi)|%xd(Bj)|%xd(Bk)|%xd(Bl)|%xd(Bm)|%xd(Bn)|%xd(Bo)|%xd(Bp)|%xd(Bq)|%xd(Br)|%xd(Bs)|%xd(Bt)|%xd(Bu)|%xd(Bv)|%xd(Bw)|%xd(Bx)||>>

%Vl(Nav,0,25,320,18,3)%Vf(FFFFFF)%acNow Playing
%Vl(AlbumArt,28,64,128,128,-)%?C(1)<%Cd(1)|%xd(PlayerFallback)>
%Vl(Title,180,62,122,28,5)%Vf(111111)%s%al%?it<%it|%fn>
%Vl(Artist,180,94,122,18,3)%Vf(555D67)%s%al%?ia<%ia|%d(1)>
%Vl(Album,180,121,122,18,3)%Vf(555D67)%s%al%?id<%id|%d(2)>
%Vl(Playback,207,162,16,16,-)%?mp<|%xd(PlayIcon,1)|%xd(PlayIcon,2)|||||%xd(PlayIcon,1)|%xd(PlayIcon,2)>
%Vl(Shuffle,187,166,14,12,-)%xd(ShuffleIcon,%ps)
%Vl(Repeat,282,163,18,17,-)%xd(RepeatIcon,%mm)
%Vl(ProgressLeft,18,195,55,14,2)%Vf(333333)%ar%pc
%Vl(ProgressRight,247,195,55,14,2)%Vf(333333)%al%pt
%Vl(Progress,39,218,242,12,-)%pb(0,0,242,12,SliderThinPurple12.bmp,slider,PlayerSliderThinPurple12,backdrop,SliderBackdropThinPurple12)

%Vl(VolumeCard,70,110,180,45,-)%xd(VolumeBackdrop)
%Vl(VolumeIcon,84,122,24,21,-)
%?if(%pv, =, -90)<%xd(VolumeIcons,1)>
%?and(%if(%pv, <=, -60),%if(%pv, >, -90))<%xd(VolumeIcons,2)>
%?and(%if(%pv, <=, -30),%if(%pv, >, -60))<%xd(VolumeIcons,3)>
%?if(%pv, >, -30)<%xd(VolumeIcons,4)>
%Vl(VolumeSlider,116,130,117,5,-)%?if(%pv, =, -90)<%xd(VolumeSliderBackdrop)|%pv(0,0,117,5,VolumeSliderPurple.bmp,slider,VolumeSliderEndPurple,backdrop,VolumeSliderBackdropPurple)>

%Vl(LockStatus,8,4,80,12,2)%Vf(FFFFFF)%aliPod
%Vl(LockStatus,244,3,16,13,-)%?mp<|%xd(Pa)|%xd(Pb)|%xd(Pc)|%xd(Pd)|||%xd(Pa)|%xd(Pb)>
%Vl(LockStatus,287,4,25,11,-)
%?bp<%?bc<%t(1.0)%xd(Ba);%t(1.0)%xd(Bb)|%xd(Bc)>|%?bl<%xd(Bd)|%xd(Bd)|%xd(Be)|%xd(Bf)|%xd(Bg)|%xd(Bh)|%xd(Bi)|%xd(Bj)|%xd(Bk)|%xd(Bl)|%xd(Bm)|%xd(Bn)|%xd(Bo)|%xd(Bp)|%xd(Bq)|%xd(Br)|%xd(Bs)|%xd(Bt)|%xd(Bu)|%xd(Bv)|%xd(Bw)|%xd(Bx)||>>
%Vl(LockClock,0,52,320,54,4)%Vf(FFFFFF)%ac%cl:%cM %cP
%Vl(LockDate,0,111,320,20,3)%Vf(FFFFFF)%ac%?cu<Monday|Tuesday|Wednesday|Thursday|Friday|Saturday|Sunday>
%Vl(LockCardArt,28,161,51,51,-)%Cl(0,0,51,51,c,c,2)%?C(2)<%Cd(2)|%xd(NotificationMusic)>
%Vl(LockCardTitle,92,166,136,18,2)%Vf(FFFFFF)%s%al%?it<%it|%fn>
%Vl(LockCardSub,92,184,136,18,2)%Vf(CFD8E6)%s%al%?ia<%ia|%d(1)>
%Vl(LockCardIcon,258,175,16,18,-)%?mp<|%xd(LockPlayIcon,1)|%xd(LockPlayIcon,2)|||||%xd(LockPlayIcon,1)|%xd(LockPlayIcon,2)>
