%Vl(SpringPod3HoldCfgInfo1,160,46,160,14,2)%Vf(596676)%acNormal/On: Lockscreen
%Vl(SpringPod3HoldCfgInfo2,160,60,160,14,2)%Vf(596676)%acOff: Always On Display
%Vl(SpringPod3HoldCfgLsImg,178,70,125,40,-)%xd(LsStyle)
%Vl(SpringPod3HoldCfgAodImg,178,130,125,40,-)%xd(AodStyle)
