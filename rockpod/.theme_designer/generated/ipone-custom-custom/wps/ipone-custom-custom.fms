#------------ Lockscreen / Always On Display ------------#
# Match adwaitapod behaviour:
# - Hold switch shows a lockscreen using Wallpaper.bmp
# - If "Backlight on Hold" is Off, show an AOD-friendly white screen instead
%xl(LsWallpaper,Wallpaper.bmp)
%xl(SlideBack,LargeSliderBackdrop.bmp)
%xl(SlideKnob,LargeSliderFallback.bmp)
%Vl(iPoneLockscreen,0,0,-,-,4)%Vf(0D111B)%Vb(000000)
%xd(LsWallpaper)
%Vl(iPoneLockscreen,12,10,16,16,-)%xd(h)
%Vl(iPoneLockscreen,32,8,60,16,2)%Vf(0D111B)%alHOLD
%Vl(iPoneLockscreen,287,10,25,11,-)
%?bp<%?bc<%t(1.0)%xd(Ba);%t(1.0)%xd(Bb)|%xd(Bc)>|%?bl<%xd(Bd)|%xd(Bd)|%xd(Be)|%xd(Bf)|%xd(Bg)|%xd(Bh)|%xd(Bi)|%xd(Bj)|%xd(Bk)|%xd(Bl)|%xd(Bm)|%xd(Bn)|%xd(Bo)|%xd(Bp)|%xd(Bq)|%xd(Br)|%xd(Bs)|%xd(Bt)|%xd(Bu)|%xd(Bv)|%xd(Bw)|%xd(Bx)||>>
%Vl(iPoneLockscreen,242,8,44,16,2)%Vf(0D111B)%ar%bl%%
%Vl(iPoneLockscreen,0,55,-,60,4)%Vf(0D111B)%ac%cl:%cM %cP
%Vl(iPoneLockscreen,0,120,-,20,3)%Vf(0D111B)%ac%?if(%ss(0,7,%St(lang)), =, english)<%?cu<Monday|Tuesday|Wednesday|Thursday|Friday|Saturday|Sunday>|%ca> %?or(%if(%ss(0,7,%St(lang)), =, chinese),%if(%St(lang), =, magyar),%if(%St(lang), =, lietuviu),%if(%St(lang), =, japanese),%if(%St(lang), =, korean))<%cb %cd|%?if(%St(lang), =, english-us)<%cb %cd|%cd %cb>>
%Vl(iPoneLockscreen,0,160,-,18,2)%Vf(0D111B)%ac%?tm<%?tx<%ty|FM Radio>|%Tn>
%Vl(iPoneLockscreen,0,180,-,18,2)%Vf(0D111B)%ac%?tx<%tz|Signal: %?tr<Faint/No Signal|Weak|Fair|Strong|Very Strong>>
%Vl(iPoneLockscreen,98,208,125,28,-)%xd(SlideBack)
%Vl(iPoneLockscreen,98,208,30,28,-)%xd(SlideKnob)
%Vl(iPoneLockscreen,98,212,125,20,2)%Vf(0D111B)%acSlide to Start

%Vl(iPoneAOD,0,0,-,-,4)%Vf(000000)%Vb(0D111B)
%dr(0,0,-,-,0D111B)
%Vl(iPoneAOD,12,10,16,16,-)%Vf(000000)%xd(h)
%Vl(iPoneAOD,32,8,60,16,2)%Vf(000000)%alHOLD
%Vl(iPoneAOD,287,10,25,11,-)%Vf(000000)
%?bp<%?bc<%t(1.0)%xd(Ba);%t(1.0)%xd(Bb)|%xd(Bc)>|%?bl<%xd(Bd)|%xd(Bd)|%xd(Be)|%xd(Bf)|%xd(Bg)|%xd(Bh)|%xd(Bi)|%xd(Bj)|%xd(Bk)|%xd(Bl)|%xd(Bm)|%xd(Bn)|%xd(Bo)|%xd(Bp)|%xd(Bq)|%xd(Br)|%xd(Bs)|%xd(Bt)|%xd(Bu)|%xd(Bv)|%xd(Bw)|%xd(Bx)||>>
%Vl(iPoneAOD,242,8,44,16,2)%Vf(000000)%ar%bl%%
%Vl(iPoneAOD,0,55,-,60,4)%Vf(000000)%ac%cl:%cM %cP
%Vl(iPoneAOD,0,120,-,20,3)%Vf(000000)%ac%?if(%ss(0,7,%St(lang)), =, english)<%?cu<Monday|Tuesday|Wednesday|Thursday|Friday|Saturday|Sunday>|%ca> %?or(%if(%ss(0,7,%St(lang)), =, chinese),%if(%St(lang), =, magyar),%if(%St(lang), =, lietuviu),%if(%St(lang), =, japanese),%if(%St(lang), =, korean))<%cb %cd|%?if(%St(lang), =, english-us)<%cb %cd|%cd %cb>>
%Vl(iPoneAOD,0,160,-,18,2)%Vf(000000)%ac%?tm<%?tx<%ty|FM Radio>|%Tn>
%Vl(iPoneAOD,0,180,-,18,2)%Vf(000000)%ac%?tx<%tz|Signal: %?tr<Faint/No Signal|Weak|Fair|Strong|Very Strong>>
%Vl(iPoneAOD,98,208,125,28,-)%xd(SlideBack)
%Vl(iPoneAOD,98,208,30,28,-)%xd(SlideKnob)
%Vl(iPoneAOD,98,212,125,20,2)%Vf(000000)%acSlide to Start

