/dts-v1/;

/ {
	description = "Rockpod N25 storage-free volatile diagnostic";
	#address-cells = <1>;

	images {
		kernel {
			description = "ARMv5TE Linux zImage";
			data = /incbin/("@KERNEL@");
			type = "kernel";
			arch = "arm";
			os = "linux";
			compression = "none";
			load = <0x08008000>;
			entry = <0x08008000>;
			hash-1 {
				algo = "sha256";
			};
		};

		ramdisk {
			description = "Syscall-only storage-free PID1";
			data = /incbin/("@INITRAMFS@");
			type = "ramdisk";
			arch = "arm";
			os = "linux";
			compression = "gzip";
			load = <0x0a800000>;
			hash-1 {
				algo = "sha256";
			};
		};

		fdt {
			description = "Apple N25 RAM diagnostic device tree";
			data = /incbin/("@DTB@");
			type = "flat_dt";
			arch = "arm";
			compression = "none";
			load = <0x0a900000>;
			hash-1 {
				algo = "sha256";
			};
		};
	};

	configurations {
		default = "n25-ramdiag";
		n25-ramdiag {
			description = "N25 storage-free volatile diagnostic";
			kernel = "kernel";
			ramdisk = "ramdisk";
			fdt = "fdt";
		};
	};
};

