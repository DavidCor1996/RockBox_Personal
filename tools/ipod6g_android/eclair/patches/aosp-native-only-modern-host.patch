diff --git a/system/core/liblog/logd_write.c b/system/core/liblog/logd_write.c
--- a/system/core/liblog/logd_write.c
+++ b/system/core/liblog/logd_write.c
@@ -31,2 +31,6 @@
 #define LOG_BUF_SIZE\t1024
 
+#ifndef IPOD6G_STDERR_LOG
+#define IPOD6G_STDERR_LOG 0
+#endif
+
@@ -34,3 +38,7 @@
 #if FAKE_LOG_DEVICE
 // This will be defined when building for the host.
+int fakeLogOpen(const char *pathName, int flags);
+int fakeLogClose(int fd);
+ssize_t fakeLogWritev(int fd, const struct iovec* vector, int count);
+
 #define log_open(pathname, flags) fakeLogOpen(pathname, flags)
@@ -81,6 +89,48 @@ static int __write_to_log_null(log_id_t log_fd, struct iovec *vec, size_t nr)
     return -1;
 }
 
+#if IPOD6G_STDERR_LOG
+static int write_all_stderr(const void *buffer, size_t length)
+{
+    const char *next = buffer;
+    size_t remaining = length;
+
+    while (remaining > 0) {
+        ssize_t count = write(STDERR_FILENO, next, remaining);
+        if (count < 0 && errno == EINTR)
+            continue;
+        if (count <= 0)
+            return -1;
+        next += count;
+        remaining -= count;
+    }
+    return (int) length;
+}
+
+static int __write_to_log_stderr(log_id_t log_id, struct iovec *vec, size_t nr)
+{
+    size_t index;
+    int total = 0;
+    (void) log_id;
+
+    for (index = 1; index < nr; ++index) {
+        size_t length = vec[index].iov_len;
+        int count;
+        if (length > 0 && ((const char *) vec[index].iov_base)[length - 1] == '\0')
+            --length;
+        if (index > 1 && write_all_stderr(": ", 2) < 0)
+            return -1;
+        count = write_all_stderr(vec[index].iov_base, length);
+        if (count < 0)
+            return -1;
+        total += count;
+    }
+    if (write_all_stderr("\n", 1) < 0)
+        return -1;
+    return total + 1;
+}
+#endif
+
 static int __write_to_log_kernel(log_id_t log_id, struct iovec *vec, size_t nr)
 {
     ssize_t ret;
@@ -120,7 +170,11 @@ static int __write_to_log_init(log_id_t log_id, struct iovec *vec, size_t nr)
             log_fds[LOG_ID_MAIN] = -1;
             log_fds[LOG_ID_RADIO] = -1;
             log_fds[LOG_ID_EVENTS] = -1;
+#if IPOD6G_STDERR_LOG
+            write_to_log = __write_to_log_stderr;
+#else
             write_to_log = __write_to_log_null;
+#endif
         }
     }
 
