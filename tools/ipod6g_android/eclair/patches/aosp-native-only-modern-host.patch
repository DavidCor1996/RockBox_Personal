+#ifdef ECLAIR_NATIVE_ONLY
+static int mapHeadlessFrameBuffer(struct private_module_t* module)
+{
+    const uint32_t width = 320;
+    const uint32_t height = 240;
+    const size_t line_length = width * 2;
+    const size_t fb_size = roundUpToPageSize(line_length * height);
+    int fd = ashmem_create_region("ipod6g-headless-framebuffer", fb_size);
+
+    if (fd < 0)
+        return -errno;
+
+    memset(&module->info, 0, sizeof(module->info));
+    memset(&module->finfo, 0, sizeof(module->finfo));
+    strncpy(module->finfo.id, "ipod6g-headless", sizeof(module->finfo.id) - 1);
+    module->finfo.line_length = line_length;
+    module->finfo.smem_len = fb_size;
+    module->info.xres = width;
+    module->info.yres = height;
+    module->info.xres_virtual = width;
+    module->info.yres_virtual = height;
+    module->info.bits_per_pixel = 16;
+    module->info.red.offset = 11;
+    module->info.red.length = 5;
+    module->info.green.offset = 5;
+    module->info.green.length = 6;
+    module->info.blue.length = 5;
+    module->info.width = 51;
+    module->info.height = 38;
+    module->flags = 0;
+    module->xdpi = (width * 25.4f) / module->info.width;
+    module->ydpi = (height * 25.4f) / module->info.height;
+    module->fps = 60.0f;
+    module->numBuffers = 1;
+    module->bufferMask = 0;
+    module->framebuffer = new private_handle_t(dup(fd), fb_size,
+            private_handle_t::PRIV_FLAGS_USES_PMEM);
+
+    void* vaddr = mmap(0, fb_size, PROT_READ|PROT_WRITE, MAP_SHARED, fd, 0);
+    close(fd);
+    if (vaddr == MAP_FAILED)
+        return -errno;
+    module->framebuffer->base = intptr_t(vaddr);
+    memset(vaddr, 0, fb_size);
+    LOGI("IPOD6G_ECLAIR_HEADLESS_GRALLOC:READY 320x240 RGB565");
+    return 0;
+}
+#endif
