diff --git a/drivers/irqchip/irq-vic.c b/drivers/irqchip/irq-vic.c
index ea93e7236..aae19946c 100644
--- a/drivers/irqchip/irq-vic.c
+++ b/drivers/irqchip/irq-vic.c
@@ -61,6 +61,7 @@
 struct vic_device {
 	void __iomem	*base;
 	int		irq;
+	bool		s5l8702;
 	u32		valid_sources;
 	u32		resume_sources;
 	u32		resume_irqs;
@@ -105,7 +106,10 @@ static void resume_one_vic(struct vic_device *vic)
 	printk(KERN_DEBUG "%s: resuming vic at %p\n", __func__, base);
 
 	/* re-initialise static settings */
-	vic_init2(base);
+	if (vic->s5l8702)
+		writel(~0, base + VIC_PL192_VECT_ADDR);
+	else
+		vic_init2(base);
 
 	writel(vic->int_select, base + VIC_INT_SELECT);
 	writel(vic->protect, base + VIC_PROTECT);
@@ -205,11 +209,16 @@ static int handle_one_vic(struct vic_device *vic, struct pt_regs *regs)
 	u32 stat, irq;
 	int handled = 0;
 
+	if (vic->s5l8702)
+		readl_relaxed(vic->base + VIC_PL192_VECT_ADDR);
+
 	while ((stat = readl_relaxed(vic->base + VIC_IRQ_STATUS))) {
 		irq = ffs(stat) - 1;
 		generic_handle_domain_irq(vic->domain, irq);
 		handled = 1;
 	}
+	if (vic->s5l8702)
+		writel_relaxed(0, vic->base + VIC_PL192_VECT_ADDR);
 
 	return handled;
 }
@@ -221,11 +230,15 @@ static void vic_handle_irq_cascaded(struct irq_desc *desc)
 	struct vic_device *vic = irq_desc_get_handler_data(desc);
 
 	chained_irq_enter(host_chip, desc);
+	if (vic->s5l8702)
+		readl_relaxed(vic->base + VIC_PL192_VECT_ADDR);
 
 	while ((stat = readl_relaxed(vic->base + VIC_IRQ_STATUS))) {
 		hwirq = ffs(stat) - 1;
 		generic_handle_domain_irq(vic->domain, hwirq);
 	}
+	if (vic->s5l8702)
+		writel_relaxed(0, vic->base + VIC_PL192_VECT_ADDR);
 
 	chained_irq_exit(host_chip, desc);
 }
@@ -279,6 +292,8 @@ static void __init vic_register(void __iomem *base, unsigned int parent_irq,
 
 	v = &vic_devices[vic_id];
 	v->base = base;
+	v->s5l8702 = node &&
+		of_device_is_compatible(node, "apple,s5l8702-vic");
 	v->valid_sources = valid_sources;
 	v->resume_sources = resume_sources;
 	set_handle_irq(vic_handle_irq);
@@ -437,6 +452,36 @@ static void __init __vic_init(void __iomem *base, int parent_irq, int irq_start,
 	unsigned int i;
 	u32 cellid = 0;
 	enum amba_vendor vendor;
+	bool s5l8702 = node &&
+		of_device_is_compatible(node, "apple,s5l8702-vic");
+	static bool s5l8702_edges_initialized;
+
+	if (s5l8702) {
+		void __iomem *edge;
+
+		/*
+		 * S5L8702 integrates a PL192 whose programmer model is not
+		 * PL190-compatible.  Match the sequence used by Rockbox on N25:
+		 * disable every source, reset the PL192 priority stack through
+		 * VICADDRESS, and select edge handling in the shared edge block.
+		 */
+		vic_disable(base);
+		writel(~0, base + VIC_PL192_VECT_ADDR);
+		if (!s5l8702_edges_initialized) {
+			edge = ioremap(0x38e02000, 0x10);
+			if (!edge) {
+				pr_err("VIC: failed to map S5L8702 edge registers\n");
+				return;
+			}
+			writel(~0, edge + 0x08);
+			writel(~0, edge + 0x0c);
+			iounmap(edge);
+			s5l8702_edges_initialized = true;
+		}
+		vic_register(base, parent_irq, irq_start, vic_sources,
+			     resume_sources, node);
+		return;
+	}
 
 	/* Identify which VIC cell this one is, by reading the ID */
 	for (i = 0; i < 4; i++) {
@@ -511,5 +556,6 @@ static int __init vic_of_init(struct device_node *node,
 }
 IRQCHIP_DECLARE(arm_pl190_vic, "arm,pl190-vic", vic_of_init);
 IRQCHIP_DECLARE(arm_pl192_vic, "arm,pl192-vic", vic_of_init);
+IRQCHIP_DECLARE(apple_s5l8702_vic, "apple,s5l8702-vic", vic_of_init);
 IRQCHIP_DECLARE(arm_versatile_vic, "arm,versatile-vic", vic_of_init);
 #endif /* CONFIG OF */
