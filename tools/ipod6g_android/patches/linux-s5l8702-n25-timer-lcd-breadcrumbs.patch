From: Rockpod N25 platform work
Subject: [PATCH] clocksource: s5l8702: expose N25 timer milestones on LCD

Paint yellow only after Timer E is observed advancing, then paint blue from
the first acknowledged Timer B interrupt. This makes the storage-free N25
probe distinguish clocksource and physical IRQ delivery without serial or
persistent logging. The code runs only for the apple,n25-timer compatible.

diff --git a/drivers/clocksource/timer-s5l8702.c b/drivers/clocksource/timer-s5l8702.c
index e5b723836..82d36b06f 100644
--- a/drivers/clocksource/timer-s5l8702.c
+++ b/drivers/clocksource/timer-s5l8702.c
@@ -61,15 +61,34 @@
 
 struct s5l8702_tcu {
 	void __iomem *base;
+	void __iomem *diag_lcd;
 	u32 clkevt;
 	u32 clksrc;
 	u32 clkevt_rate;
 	u32 clkevt_max;
 	bool n25;
+	bool diag_irq_marked;
 };
 
 static struct s5l8702_tcu *s5l8702_tcu;
 
+#define N25_LCD_STATUS  0x1c
+#define N25_LCD_WDATA   0x40
+#define N25_LCD_BAND_PIXELS  (320 * 48)
+
+static void s5l8702_n25_lcd_mark(struct s5l8702_tcu *t, u32 color)
+{
+	unsigned int i;
+
+	if (!t->diag_lcd)
+		return;
+	for (i = 0; i < N25_LCD_BAND_PIXELS; i++) {
+		while (readl_relaxed(t->diag_lcd + N25_LCD_STATUS) & BIT(4))
+			cpu_relax();
+		writel_relaxed(color, t->diag_lcd + N25_LCD_WDATA);
+	}
+}
+
 /* --- Clocksource --- */
 
 static u64 notrace s5l8702_read_sched_clock(void)
@@ -149,6 +168,10 @@ static irqreturn_t s5l8702_timer_interrupt(int irq, void *dev_id)
 			     s5l8702_tcu->clkevt + REG_CON);
 		writel(stat, s5l8702_tcu->base +
 		       s5l8702_tcu->clkevt + REG_CON);
+		if (!s5l8702_tcu->diag_irq_marked) {
+			s5l8702_tcu->diag_irq_marked = true;
+			s5l8702_n25_lcd_mark(s5l8702_tcu, 0x001f);
+		}
 	} else {
 		stat = readl(s5l8702_tcu->base + REG_TSTAT);
 		writel(stat, s5l8702_tcu->base + REG_TSTAT);
@@ -208,6 +231,14 @@ static int __init s5l8702_timer_init(struct device_node *np)
 		ret = -ENXIO;
 		goto out_free;
 	}
+	if (tcu->n25) {
+		tcu->diag_lcd = ioremap(0x38300000, 0x100);
+		if (!tcu->diag_lcd) {
+			pr_err("s5l8702-timer: can't map diagnostic LCD\n");
+			ret = -ENXIO;
+			goto out_free;
+		}
+	}
 
 	s5l8702_tcu = tcu;
 
@@ -236,6 +267,8 @@ static int __init s5l8702_timer_init(struct device_node *np)
 		ret = -ENODEV;
 		goto out_free;
 	}
+	if (tcu->n25)
+		s5l8702_n25_lcd_mark(tcu, 0xffe0);
 
 	clocksource_mmio_init(tcu->base + tcu->clksrc + REG_CNT,
 			      "s5l8702-timerG", TIMER_RATE,
@@ -264,6 +297,8 @@ static int __init s5l8702_timer_init(struct device_node *np)
 	return 0;
 
 out_free:
+	if (tcu->diag_lcd)
+		iounmap(tcu->diag_lcd);
 	kfree(tcu);
 	return ret;
 }
-- 
