diff --git a/drivers/power/reset/s5l8702-restart.c b/drivers/power/reset/s5l8702-restart.c
new file mode 100644
index 000000000..1303cfaba
--- /dev/null
+++ b/drivers/power/reset/s5l8702-restart.c
@@ -0,0 +1,129 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Rockbox-proven watchdog restart for Samsung S5L8702. */
+
+#include <linux/delay.h>
+#include <linux/io.h>
+#include <linux/jiffies.h>
+#include <linux/module.h>
+#include <linux/notifier.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/reboot.h>
+#include <linux/workqueue.h>
+
+#define S5L8702_WATCHDOG_RESET	0x00100000
+#define S5L8702_MIN_TIMEOUT	30
+#define S5L8702_MAX_TIMEOUT	600
+
+struct s5l8702_restart {
+	struct device *dev;
+	void __iomem *base;
+	struct notifier_block restart_nb;
+	struct delayed_work timeout_work;
+	u32 timeout_seconds;
+};
+
+static int s5l8702_restart_handler(struct notifier_block *nb,
+				   unsigned long mode, void *cmd)
+{
+	struct s5l8702_restart *restart =
+		container_of(nb, struct s5l8702_restart, restart_nb);
+
+	local_irq_disable();
+	writel(S5L8702_WATCHDOG_RESET, restart->base);
+	mb();
+	while (1)
+		cpu_relax();
+
+	return NOTIFY_DONE;
+}
+
+static void s5l8702_timeout_work(struct work_struct *work)
+{
+	struct s5l8702_restart *restart =
+		container_of(to_delayed_work(work), struct s5l8702_restart,
+			     timeout_work);
+
+	dev_emerg(restart->dev,
+		  "volatile test window expired after %u seconds; resetting\n",
+		  restart->timeout_seconds);
+	emergency_restart();
+}
+
+static void s5l8702_unregister_restart(void *data)
+{
+	struct s5l8702_restart *restart = data;
+
+	unregister_restart_handler(&restart->restart_nb);
+}
+
+static int s5l8702_restart_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct s5l8702_restart *restart;
+	int ret;
+
+	restart = devm_kzalloc(dev, sizeof(*restart), GFP_KERNEL);
+	if (!restart)
+		return -ENOMEM;
+	restart->dev = dev;
+	restart->base = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(restart->base))
+		return PTR_ERR(restart->base);
+
+	restart->restart_nb.notifier_call = s5l8702_restart_handler;
+	restart->restart_nb.priority = 192;
+	ret = register_restart_handler(&restart->restart_nb);
+	if (ret)
+		return dev_err_probe(dev, ret,
+				     "cannot register restart handler\n");
+	ret = devm_add_action_or_reset(dev, s5l8702_unregister_restart,
+				       restart);
+	if (ret)
+		return ret;
+
+	if (!of_property_read_u32(dev->of_node,
+				  "apple,test-timeout-seconds",
+				  &restart->timeout_seconds)) {
+		if (restart->timeout_seconds < S5L8702_MIN_TIMEOUT ||
+		    restart->timeout_seconds > S5L8702_MAX_TIMEOUT)
+			return dev_err_probe(dev, -ERANGE,
+				"test timeout must be between 30 and 600 seconds\n");
+		INIT_DELAYED_WORK(&restart->timeout_work, s5l8702_timeout_work);
+		schedule_delayed_work(&restart->timeout_work,
+			msecs_to_jiffies(restart->timeout_seconds * 1000));
+		dev_warn(dev, "volatile test reset armed for %u seconds\n",
+			 restart->timeout_seconds);
+	}
+
+	platform_set_drvdata(pdev, restart);
+	dev_info(dev, "Rockbox-derived S5L8702 restart handler ready\n");
+	return 0;
+}
+
+static void s5l8702_restart_remove(struct platform_device *pdev)
+{
+	struct s5l8702_restart *restart = platform_get_drvdata(pdev);
+
+	if (restart->timeout_seconds)
+		cancel_delayed_work_sync(&restart->timeout_work);
+}
+
+static const struct of_device_id s5l8702_restart_of_match[] = {
+	{ .compatible = "apple,s5l8702-watchdog-reset" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, s5l8702_restart_of_match);
+
+static struct platform_driver s5l8702_restart_driver = {
+	.probe = s5l8702_restart_probe,
+	.remove = s5l8702_restart_remove,
+	.driver = {
+		.name = "s5l8702-restart",
+		.of_match_table = s5l8702_restart_of_match,
+	},
+};
+module_platform_driver(s5l8702_restart_driver);
+
+MODULE_DESCRIPTION("Samsung S5L8702 watchdog restart");
+MODULE_LICENSE("GPL");
