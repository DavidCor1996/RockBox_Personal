diff --git a/board/apple/n25_ramdiag/n25_ramdiag.c b/board/apple/n25_ramdiag/n25_ramdiag.c
new file mode 100644
index 00000000..388b83bc
--- /dev/null
+++ b/board/apple/n25_ramdiag/n25_ramdiag.c
@@ -0,0 +1,207 @@
+// SPDX-License-Identifier: GPL-2.0+
+/* Storage-free volatile diagnostic target for Apple N25. */
+
+#include <asm/global_data.h>
+#include <asm/io.h>
+#include <asm/arch-s5l87xx/s5l87xx.h>
+#include <linux/errno.h>
+
+DECLARE_GLOBAL_DATA_PTR;
+
+#define N25_CLKCON0            (S5L87XX_CLK_BASE + 0x00)
+#define N25_CG16_RTIME         (S5L87XX_CLK_BASE + 0x12)
+#define N25_PLLMODE            (S5L87XX_CLK_BASE + 0x44)
+#define N25_CLKCON0_SDR_OFF    BIT(31)
+#define N25_PLLMODE_OSCSEL     BIT(8)
+
+#define N25_MIU_BASE           0x38100000
+#define N25_MIU_REG(off)       (N25_MIU_BASE + (off))
+#define N25_MIUCON             N25_MIU_REG(0x00)
+#define N25_MIUCOM             N25_MIU_REG(0x04)
+#define N25_MIUAREF            N25_MIU_REG(0x08)
+#define N25_MIUMRS             N25_MIU_REG(0x0c)
+#define N25_MIUSDPARA          N25_MIU_REG(0x10)
+
+#define N25_DRAM_BASE          0x08000000
+#define N25_DRAM_BANK_SIZE     0x02000000
+
+static void n25_miu_command(uint32_t command)
+{
+    writel(command, N25_MIUCOM);
+}
+
+/*
+ * This is the IPOD_6G cold-start sequence from Rockbox's
+ * miu_preinit(false). It runs from IRAM before U-Boot relocates to SDRAM.
+ */
+void n25_dram_cold_init(void)
+{
+    uint32_t value;
+    int i;
+
+    /* Keep the ROM's CPU/AHB/APB clocks; select OSC0 for 12 MHz MIU_Clk. */
+    clrbits_le32(N25_CLKCON0, N25_CLKCON0_SDR_OFF);
+    clrbits_le32(N25_PLLMODE, N25_PLLMODE_OSCSEL);
+    value = readl(N25_CG16_RTIME & ~3);
+    value &= 0x0000ffff;
+    writel(value, N25_CG16_RTIME & ~3);
+
+    /* Rockbox clock gates CLOCKGATE_SMx=3 and CLOCKGATE_SM1=4. */
+    s5l87xx_enable_clkgate_bit(0, 3);
+    s5l87xx_enable_clkgate_bit(0, 4);
+
+    writel(0x80d, N25_MIUCON);
+    writel(0, N25_MIU_REG(0xf0));
+    writel(0x6105d, N25_MIUAREF);
+    writel(0x1fb621, N25_MIUSDPARA);
+
+    writel(0x1845, N25_MIU_REG(0x200));
+    writel(0x1845, N25_MIU_REG(0x204));
+    writel(0x1800, N25_MIU_REG(0x210));
+    writel(0x1800, N25_MIU_REG(0x214));
+    writel(0x1845, N25_MIU_REG(0x220));
+    writel(0x1845, N25_MIU_REG(0x224));
+    writel(0x1885, N25_MIU_REG(0x230));
+    writel(0x1885, N25_MIU_REG(0x234));
+    writel(0x19, N25_MIU_REG(0x14));
+    writel(0x19, N25_MIU_REG(0x18));
+    writel(0x0790682b, N25_MIU_REG(0x1c));
+    clrbits_le32(N25_MIU_REG(0x314), 0x10);
+
+    for (i = 0; i < 0x24; i++)
+        clrbits_le32(N25_MIU_REG(0x2c + i * 4), BIT(24));
+
+    writel(0x540, N25_MIU_REG(0x1cc));
+    setbits_le32(N25_MIU_REG(0x1d4), 0x80);
+
+    n25_miu_command(0x33);
+    n25_miu_command(0x33);
+    n25_miu_command(0x233);
+    n25_miu_command(0x33);
+    n25_miu_command(0x33);
+    n25_miu_command(0x33);
+    n25_miu_command(0x333);
+    n25_miu_command(0x33);
+    n25_miu_command(0x33);
+    n25_miu_command(0x33);
+    n25_miu_command(0x333);
+    n25_miu_command(0x33);
+    n25_miu_command(0x33);
+    n25_miu_command(0x33);
+
+    writel(0x33, N25_MIUMRS);
+    n25_miu_command(0x133);
+    n25_miu_command(0x33);
+    n25_miu_command(0x33);
+    n25_miu_command(0x33);
+    writel(0x8040, N25_MIUMRS);
+    n25_miu_command(0x133);
+    n25_miu_command(0x33);
+    n25_miu_command(0x33);
+    n25_miu_command(0x33);
+
+    setbits_le32(N25_MIUAREF, 0x61000);
+}
+
+/* Detect a missing second 32 MiB bank or an address-line alias. */
+int n25_dram_probe(void)
+{
+    static const uintptr_t address[] = {
+        N25_DRAM_BASE,
+        N25_DRAM_BASE + N25_DRAM_BANK_SIZE - sizeof(uint32_t),
+        N25_DRAM_BASE + N25_DRAM_BANK_SIZE,
+        N25_DRAM_BASE + 2 * N25_DRAM_BANK_SIZE - sizeof(uint32_t),
+    };
+    static const uint32_t pattern[] = {
+        0x55aa00ff, 0xaa55ff00, 0x0ff033cc, 0xf00fcc33,
+    };
+    int i;
+
+    for (i = 0; i < ARRAY_SIZE(address); i++)
+        writel(pattern[i], address[i]);
+
+    for (i = 0; i < ARRAY_SIZE(address); i++) {
+        if (readl(address[i]) != pattern[i])
+            return -EIO;
+    }
+
+    for (i = 0; i < ARRAY_SIZE(address); i++)
+        writel(0, address[i]);
+
+    return 0;
+}
+
+int dram_init(void)
+{
+    return fdtdec_setup_mem_size_base();
+}
+
+int dram_init_banksize(void)
+{
+    return fdtdec_setup_memory_banksize();
+}
+
+void lowlevel_init(void)
+{
+}
+
+int board_init(void)
+{
+    return 0;
+}
+
+void reset_cpu(void)
+{
+    s5l87xx_reset_cpu();
+}
+
+ulong get_tbclk(void)
+{
+    return 1000000;
+}
+
+int print_cpuinfo(void)
+{
+    printf("CPU: Samsung S5L8702 / Apple N25 RAM diagnostic\n");
+    return 0;
+}
+
+static void board_clock_init(void)
+{
+    s5l87xx_enable_clkgate("uart0");
+    s5l87xx_enable_clkgate("timer");
+    s5l87xx_enable_clkgate("usb-otg");
+    s5l87xx_enable_clkgate("usb2-phy");
+
+    /* Keep the DWC2 device core accessible to the RAM-only DFU command. */
+    writel(0, S5L87XX_OTG_BASE + 0xe00);
+}
+
+static void board_vic_init(void)
+{
+    writel(0xffffffff, S5L87XX_VICINTENCLEAR(0));
+    writel(0xffffffff, S5L87XX_VICINTENCLEAR(1));
+}
+
+int board_early_init_f(void)
+{
+    board_clock_init();
+    n25_dram_cold_init();
+    if (n25_dram_probe())
+        return -EIO;
+    board_vic_init();
+    return 0;
+}
+
+void board_debug_uart_init(void)
+{
+    uint32_t gpio = readl(S5L87XX_PCON(0));
+
+    /* Rockbox proves UART0 RX/TX on N25 bank 0 pins 4 and 5. */
+    gpio &= S5L87XX_PCON_PINS_CLEAR_FN(4, 5);
+    gpio |= S5L87XX_PCON_PINS_SET_FN(4, 5, 0x2);
+    writel(gpio, S5L87XX_PCON(0));
+
+    s5l87xx_enable_clkgate_bit(1, 9);
+    s5l87xx_enable_clkgate_bit(9, 7);
+}
