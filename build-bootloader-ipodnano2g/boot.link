ENTRY(start)
OUTPUT_FORMAT(elf32-littlearm)
OUTPUT_ARCH(arm)
STARTUP(target/arm/s5l8700/crt0.o)
MEMORY
{
    DRAM : ORIGIN = 0x08000000 + ((32 - 1) * 0x100000), LENGTH = 0x00100000
    IRAM : ORIGIN = 0x22000000, LENGTH = 176K
    FLASH : ORIGIN = 0x24000000, LENGTH = 1M
}
SECTIONS
{
  .text : {
    *(.intvect)
    *(.init.text)
    *(.text*)
    *(.glue_7*)
  } > IRAM
  .rodata : {
    *(.rodata*)
    . = ALIGN(0x4);
  } > IRAM
  .data : {
    _datastart = . ;
    *(.irodata*)
    *(.icode*)
    *(.idata*)
    *(.data*)
    *(.ncdata*);
    . = ALIGN(0x4);
    _dataend = . ;
   } > IRAM AT> IRAM
   _datacopy = LOADADDR(.data) ;
  .stack (NOLOAD) :
  {
     *(.stack)
     _stackbegin = .;
     stackbegin = .;
     . += 0x2000;
     _stackend = .;
     stackend = .;
     _irqstackbegin = .;
     . += 0x400;
     _irqstackend = .;
     _fiqstackbegin = .;
     . += 0x400;
     _fiqstackend = .;
  } > IRAM
  .bss (NOLOAD) : {
     _edata = .;
     *(.bss*);
     *(.ibss*);
     *(.ncbss*);
     *(COMMON);
    . = ALIGN(0x4);
     _end = .;
  } > DRAM
}
