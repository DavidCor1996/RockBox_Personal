# iPone WPS with Explicit Icon Debug
%wd

# --- Fonts ---
%Fl(2,14-Adobe-Helvetica-Bold.fnt)
%Fl(3,16-Adobe-Helvetica-Bold.fnt)
%Fl(4,35-Adobe-Helvetica-Bold.fnt)
%Fl(5,18-Adobe-Helvetica-Bold.fnt)

# --- Bitmaps ---
%xl(Explicit,explicit.bmp,0,0)

# --- Background ---
%V(0,0,-,-,-)
%Vf(000000)
%dr(0,0,-,-,000000)

# --- Album Art ---
%Vl(Art,20,40,120,120,-)
%Cl(0,0,120,120,c,c)
%Cd

# --- Track Info ---
%Vl(TrackInfo,160,40,140,80,2)
%Vf(FFFFFF)
%al%s%?it<%it|%fn>
%al%s%?ia<%ia|Unknown Artist>
%al%s%?id<%id|Unknown Album>

# --- Explicit Badge ---
%Vl(ExplicitBadge,270,40,24,24,-)
%?if(%IG, =, Explicit)<%xd(Explicit)>

# --- Time ---
%Vl(Time,160,130,140,30,3)
%Vf(E8DFF8)
%ac%pc / %pt

# --- Progress Bar ---
%Vl(Progress,20,180,280,10,-)
%pb(0,0,280,10)

# --- Volume ---
%Vl(Volume,20,200,280,20,2)
%acVol: %pv dB

# --- Debug line ---
%Vl(DebugGrouping,0,220,320,20,2)
%Vf(AAAAAA)
%acGROUPING:%IG
