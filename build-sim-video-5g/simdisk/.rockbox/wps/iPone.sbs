#------------ Settings Preview (adwaitapod-style) ------------#
# Show a preview panel when adjusting "Backlight on Hold/Lock".
%Vl(iPoneHoldCfgPanel,0,0,-,-,-)
%dr(160,19,160,221,000000)
%?if(%St(backlight on button hold), =, off)<%dr(176,68,129,44,333333)%dr(176,128,129,44,186DBD)|%dr(176,68,129,44,186DBD)%dr(176,128,129,44,333333)>
%dr(178,70,125,40,000000)%dr(178,130,125,40,000000)
%Vl(iPoneHoldCfgTitle,160,23,160,18,2)%Vf(FFFFFF)%ac%Lt
%Vl(iPoneHoldCfgInfo1,160,46,160,14,2)%Vf(AAAAAA)%acNormal/On: Lockscreen
%Vl(iPoneHoldCfgInfo2,160,60,160,14,2)%Vf(AAAAAA)%acOff: Always On Display
%Vl(iPoneHoldCfgLsImg,178,70,125,40,-)%xd(LsStyle)
%Vl(iPoneHoldCfgAodImg,178,130,125,40,-)%xd(AodStyle)
%Vl(iPoneHoldCfgLsLbl,160,112,160,14,2)%Vf(FFFFFF)%acLockscreen
%Vl(iPoneHoldCfgAodLbl,160,172,160,14,2)%Vf(FFFFFF)%acAlways On Display
%Vl(iPoneHoldCfgMode,160,206,160,14,2)%Vf(AAAAAA)%acMode: %St(backlight on button hold)

# Draw config preview on Settings screen.
%?or(%if(%Lt, =, %Sx(Backlight on Hold)),%if(%Lt, =, %Sx(Backlight on Button Hold)),%if(%Lt, =, %Sx(Backlight on Lock)))<%Vd(iPoneHoldCfgPanel)%Vd(iPoneHoldCfgTitle)%Vd(iPoneHoldCfgInfo1)%Vd(iPoneHoldCfgInfo2)%Vd(iPoneHoldCfgLsImg)%Vd(iPoneHoldCfgAodImg)%Vd(iPoneHoldCfgLsLbl)%Vd(iPoneHoldCfgAodLbl)%Vd(iPoneHoldCfgMode)|>
