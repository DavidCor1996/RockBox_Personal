#-------------------------------------------------------------------
# Adwaitapod - iPone Mod
# Fixed: Removed logic from header to prevent render failure
#-------------------------------------------------------------------
%wd
%Fl(3,16-Cantarell-Regular.fnt,11)
%Fl(4,18-Cantarell-Regular.fnt)
%Fl(5,18-Cantarell-Bold.fnt)
%Fl(6,20-Cantarell-Regular.fnt)
%Fl(7,20-Cantarell-Bold.fnt)
%Fl(8,66-Cantarell-Light.fnt,16)

#-- Icons (Must be static definitions) --#
%xl(PlayIcon,PlayStatus.bmp,9)
%xl(PlayIconTop,PlayStatusPurple.bmp,9)
%xl(SleepIcon,SleepStatus.bmp,2,1)
%xl(SleepIconAOD,SleepStatusAOD.bmp,2,1)
%xl(HoldIcon,HoldStatus.bmp,2,1)
%xl(L,LoadingStatus.bmp,12)
%xl(I,LoadingStatusAOD.bmp,12)
%xl(B,Battery.bmp,0,0,24)
%xl(ShuffleIcon,ShuffleStatus.bmp,2)
%xl(RepeatIcon,RepeatStatus.bmp,5)
%xl(ShuffleIconSmall,ShuffleStatusSmall.bmp,2)
%xl(RepeatIconSmall,RepeatStatusSmall.bmp,5)
%xl(LosslessIcon,LosslessIcon.bmp)
%xl(ExplicitIcon,ExplicitIcon.bmp)

#-- Playtime Slider --#
%xl(PlayerSlider,PlayerSlider.bmp)
%xl(PlayerSliderThin,PlayerSliderThin.bmp)
%xl(SliderBackdrop3Digits,SliderBackdrop.bmp)
%xl(SliderBackdrop4Digits,SliderBackdrop4Digits.bmp)
%xl(SliderBackdrop5Digits,SliderBackdrop5Digits.bmp)
%xl(SliderBackdrop6Digits,SliderBackdrop6Digits.bmp)
%xl(SliderBackdropThin3Digits,SliderBackdropThin.bmp)
%xl(SliderBackdropThin4Digits,SliderBackdropThin4Digits.bmp)
%xl(SliderBackdropThin5Digits,SliderBackdropThin5Digits.bmp)
%xl(SliderBackdropThin6Digits,SliderBackdropThin6Digits.bmp)
%xl(SliderThinPurple,SliderThinPurple.bmp)
%xl(PlayerSliderThinPurple,PlayerSliderThinPurple.bmp)
%xl(SliderBackdropThinPurple3Digits,SliderBackdropThinPurple.bmp)
%xl(SliderBackdropThinPurple4Digits,SliderBackdropThinPurple4Digits.bmp)
%xl(SliderBackdropThinPurple5Digits,SliderBackdropThinPurple5Digits.bmp)
%xl(SliderBackdropThinPurple6Digits,SliderBackdropThinPurple6Digits.bmp)

#-- Album Art Overlays --#
%xl(TLoverlay,WpsTL.bmp)
%xl(TRoverlay,WpsTR.bmp,138,0)
%xl(BLoverlay,WpsBL.bmp,0,138)
%xl(BRoverlay,WpsBR.bmp,138,138)
%xl(BackdropL,WpsBackdropL.bmp,69,0)
%xl(BackdropR,WpsBackdropR.bmp,233,0)
%xl(BackdropT,WpsBackdropT.bmp,87,0)
%xl(BackdropB,WpsBackdropB.bmp,87,152)
%xl(PlayerFallback,PlayerFallback.bmp,87,6)

#-- Volume --#
%xl(VolumeBackdrop,VolumeBackdrop.bmp)
%xl(VolumeIcons,VolumePromptIcons.bmp,4)
%xl(VolumeSliderBackdrop,VolumeSliderBackdrop.bmp)
%xl(VolumeSliderEnd,VolumeSliderEnd.bmp)
%xl(VolumeSliderBackdropPurple,VolumeSliderBackdropPurple.bmp)
%xl(VolumeSliderEndPurple,VolumeSliderEndPurple.bmp)
%xl(VolumeSliderPurple,VolumeSliderPurple.bmp)

#--- Lockscreen Images ---#
%xl(Lockscreen,Wallpaper.bmp)
%xl(ChargeWallpaper,ChargeWallpaper.bmp)
%xl(NotificationMusic,NotifMusic.bmp,14,12)
%xl(NotificationBackdrop,Notification.bmp,16,150)
%xl(LosslessIconLarge,LosslessIconLock.bmp)

#------------ Background Layer ------------#
%V(0,0,-,-,-)%Vb(1f1f24)%VB
%Cl(91,10,138,138,1)
%?if(%St(battery display), =, graphic)<%?mh<%?if(%St(backlight on button hold), =, off)<%xd(AODBackdrop)%dr(0,0,-,-)|%?bp<%xd(ChargeWallpaper)%?mp<|%xd(NotificationBackdrop)>|%xd(Lockscreen)%?mp<|%xd(NotificationBackdrop)>>>|%dr(0,0,-,-,1f1f24)%dr(0,0,8,-,1b1b20)%dr(312,0,8,-,1b1b20)%dr(0,0,-,8,1b1b20)%dr(0,232,-,8,151519)%dr(0,146,-,24,242429)%dr(0,170,-,28,202025)%dr(0,198,-,42,18181d)%dr(0,197,-,1,4a494a)%dr(95,14,138,138,0b0b0d)%Cd(1)%?C(1)<|%xd(PlayerFallback)>>|%dr(0,0,-,-,1f1f24)%dr(0,0,8,-,1b1b20)%dr(312,0,8,-,1b1b20)%dr(0,0,-,8,1b1b20)%dr(0,232,-,8,151519)%dr(0,146,-,24,242429)%dr(0,170,-,28,202025)%dr(0,198,-,42,18181d)%dr(0,197,-,1,4a494a)%dr(95,14,138,138,0b0b0d)%Cd(1)%?C(1)<|%xd(PlayerFallback)>>

#------------ Foreground Layer ------------#
%V(0,0,-,-,-)
%?if(%St(battery display), =, graphic)<%?if(%St(backlight on button hold), !=, off)<%?mh<%Vd(Lockscreen)%?mp<|%Vd(LockPlayer)%Vd(LockMusic)|%Vd(LockPlayer)%Vd(LockMusic)|||||%Vd(LockPlayer)%Vd(LockRadio)>>>>
%?if(%St(battery display), =, graphic)<%?if(%St(backlight on button hold), =, off)<%?mh<%Vd(AlwaysOnDisplay)>>>

#-- Call the Player Viewports --#
%Vd(Player)%Vd(ExplicitBadge)
%?mv(1.5)<%Vd(info)|%Vd(info)>

#-- Slider logic --#
%?if(%pt, >=, 36000)<%Vd(Playtime6Digits)|%?if(%pt, >=, 3600)<%Vd(Playtime5Digits)|%?if(%pt, >=, 600)<%Vd(Playtime4Digits)|%Vd(Playtime3Digits)>>>

#-- Viewport Definitions --#
%Vl(Player,12,4,16,16,-)%xd(PlayIconTop,%mp)
%Vl(Player,34,4,16,16,-)%?mh<%xd(HoldIcon,%mh)|%xd(SleepIcon,%bs)>
%Vl(Player,291,4,25,11,-)%?bp<|%?bl<%xd(Bd)|%xd(Bd)|%xd(Be)|%xd(Bf)|%xd(Bg)|%xd(Bh)|%xd(Bi)|%xd(Bj)|%xd(Bk)|%xd(Bl)|%xd(Bm)|%xd(Bn)|%xd(Bo)|%xd(Bp)|%xd(Bq)|%xd(Br)|%xd(Bs)|%xd(Bt)|%xd(Bu)|%xd(Bv)|%xd(Bw)|%xd(Bx)||>>
%Vl(Player,91,10,138,138,-)
%Vl(Player,60,152,200,28,7)%s%ac%?it<%it|%fn>
%Vl(info,60,173,200,21,6)%s%ac%?it<%?if(%St(statusbar), =,off)<%t(6)%ia;%t(6)%id;%t(0)>%?if(%St(statusbar), =,top)<%id>%?if(%St(statusbar), =,bottom)<%ia>|%d(1)>

#-- Explicit Badge Viewport --#
%Vl(ExplicitBadge,270,40,24,24,-)
%?if(%IG, =, Explicit)<%xd(ExplicitIcon)>%?

#-- Sliders --#
%Vl(Playtime3Digits,2,194,32,16,3)%ar%pc
%Vl(Playtime3Digits,39,210,242,10,-)%pb(0,0,242,10,SliderThinPurple.bmp,slider,PlayerSliderThinPurple,backdrop,SliderBackdropThinPurple3Digits)
%Vl(Playtime3Digits,286,194,32,16,3)%al%pt
# (Omitted 4/5/6 Digit Sliders for brevity, copy them from your original file)

#--- Volume Overlay ---#
%?mv(1.2)<%Vd(VolumeCard)%Vd(VolumeIcon)%Vd(VolumeSlider)|>
%Vl(VolumeCard,70,110,180,45,-)%xd(VolumeBackdrop)
%Vl(VolumeIcon,84,122,24,21,-)%?if(%pv, =, -90)<%xd(VolumeIcons,1)>%?and(%if(%pv, <=, -60),%if(%pv, >, -90))<%xd(VolumeIcons,2)>%?and(%if(%pv, <=, -30),%if(%pv, >, -60))<%xd(VolumeIcons,3)>%?if(%pv, >, -30)<%xd(VolumeIcons,4)>
%Vl(VolumeSlider,116,130,117,5,-)%?if(%pv, =, -90)<%xd(VolumeSliderBackdropPurple)|%pv(0,0,117,5,VolumeSliderPurple.bmp,slider,VolumeSliderEndPurple,backdrop,VolumeSliderBackdropPurple)>
