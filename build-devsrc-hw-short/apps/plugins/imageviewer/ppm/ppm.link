OUTPUT_FORMAT(elf32-littlearm)
MEMORY
{
   PLUGIN_RAM : ORIGIN = (((0x00000000 + ((64 * 0x100000) - 0x100000 - 0x100000)) + 0x100000) + 1039392), LENGTH = (0x100000 - 1039392)
   PLUGIN_IRAM : ORIGIN = 0x4000c000, LENGTH = 0x14000
}
SECTIONS
{
    .header : {
        _plugin_start_addr = .;
        plugin_start_addr = .;
        KEEP(*(.header))
    } > PLUGIN_RAM
    .text :
    {
        *(.text*)
        *(.glue_7)
        *(.glue_7t)
    } > PLUGIN_RAM
    .rodata :
    {
        *(.rodata*)
    } > PLUGIN_RAM
    .data :
    {
        *(.data*)
    } > PLUGIN_RAM
    .ncdata ALIGN(. + 0x10000000, 16) : ALIGN(16)
    {
        *(.ncdata*)
        . = ALIGN(16);
    } AT> PLUGIN_RAM
    /DISCARD/ :
    {
        *(.eh_frame)
    }
    .bss (NOLOAD) :
    {
     plugin_bss_start = .;
     _plugin_bss_start = .;
        *(.bss*)
        *(COMMON)
        . = ALIGN(0x4);
    } > PLUGIN_RAM
    .ncbss ALIGN(. + 0x10000000, 16) (NOLOAD) : ALIGN(16)
    {
     *(.ncbss*)
        . = ALIGN(16);
    } AT> PLUGIN_RAM
    .ncbss_vma (NOLOAD) : ALIGN(16)
    {
        . += SIZEOF(.ncbss);
    } > PLUGIN_RAM
    .pluginend (NOLOAD) :
    {
        _plugin_end_addr = .;
        plugin_end_addr = .;
    } > PLUGIN_RAM
    .iram 0x4000c000 : AT(LOADADDR(.bss))
    {
        iramstart = .;
        *(.icode)
        *(.irodata)
        *(.idata)
        iramend = .;
    } > PLUGIN_IRAM
    iramcopy = LOADADDR(.iram);
    .ibss (NOLOAD) :
    {
        iedata = .;
        *(.ibss)
        . = ALIGN(0x4);
        iend = .;
    } > PLUGIN_IRAM
    loadendaddr = MAX(plugin_end_addr, LOADADDR(.iram) + SIZEOF(.iram));
    .pluginloadend loadendaddr :
    {
     _plugin_load_end_addr = .;
     plugin_load_end_addr = .;
    }
    .comment 0 :
    {
        KEEP(*(.comment))
    }
}
ASSERT(LOADADDR(.ncdata) == ADDR(.ncdata) - 0x10000000, ".ncdata has incorrect LMA/VMA address");
ASSERT(LOADADDR(.ncdata) % 16 == 0, ".ncdata incorrectly aligned");
ASSERT(LOADADDR(.ncbss) == ADDR(.ncbss) - 0x10000000, ".ncbss has incorrect LMA/VMA address");
ASSERT(LOADADDR(.ncbss) % 16 == 0, ".ncbss incorrectly aligned");
ASSERT(ADDR(.ncbss_vma) == LOADADDR(.ncbss), ".ncbss_vma has wrong address");
ASSERT(SIZEOF(.ncbss_vma) == SIZEOF(.ncbss), ".ncbss_vma has wrong size");
