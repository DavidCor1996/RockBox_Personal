OUTPUT_FORMAT(elf32-littlearm)
MEMORY
{
   PLUGIN_RAM : ORIGIN = (((0x08000000 + (((32 * 0x100000) - 0x200000 - 0x100000 - 0x4000))) + 0x100000) + 2074496), LENGTH = (0x200000 - 2074496)
   PLUGIN_IRAM : ORIGIN = (0x00000000 + (48*1024)), LENGTH = (80*1024)
}
SECTIONS
{
    .header : {
        _plugin_start_addr = .;
        plugin_start_addr = .;
        KEEP(*(.header))
    } > PLUGIN_RAM
    .text :
    {
        *(.text*)
        *(.glue_7)
        *(.glue_7t)
    } > PLUGIN_RAM
    .rodata :
    {
        *(.rodata*)
    } > PLUGIN_RAM
    .data :
    {
        *(.data*)
    } > PLUGIN_RAM
    /DISCARD/ :
    {
        *(.eh_frame)
    }
    .bss (NOLOAD) :
    {
     plugin_bss_start = .;
     _plugin_bss_start = .;
        *(.bss*)
        *(COMMON)
        . = ALIGN(0x4);
    } > PLUGIN_RAM
    .pluginend (NOLOAD) :
    {
        _plugin_end_addr = .;
        plugin_end_addr = .;
    } > PLUGIN_RAM
    .iram (0x00000000 + (48*1024)) : AT(LOADADDR(.bss))
    {
        iramstart = .;
        *(.icode)
        *(.irodata)
        *(.idata)
        iramend = .;
    } > PLUGIN_IRAM
    iramcopy = LOADADDR(.iram);
    .ibss (NOLOAD) :
    {
        iedata = .;
        *(.ibss)
        . = ALIGN(0x4);
        iend = .;
    } > PLUGIN_IRAM
    loadendaddr = MAX(plugin_end_addr, LOADADDR(.iram) + SIZEOF(.iram));
    .pluginloadend loadendaddr :
    {
     _plugin_load_end_addr = .;
     plugin_load_end_addr = .;
    }
    .comment 0 :
    {
        KEEP(*(.comment))
    }
}
