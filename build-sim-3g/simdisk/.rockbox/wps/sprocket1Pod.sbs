# Theme Name: sprocket1Pod
# By: Le Khanh Binh <lekhanhbinh2901@gmail.com> 
# Platform: iPod 1G 2G 3G 4G (160x128, 4 colour grayscale)
# License: CC-BY-SA 3.0
# Version: 1.0
# Last updated: 2026-04-04
# Original Theme: sprocket by Cam Mendoza (https://github.com/gogi-goji/sprocket-rockbox-theme)
# Based on a modified version of sprocket, sprocketModern by OlsroFR

# --- INITIALIZATION ---
%wd
%?Lt<|>

%Fl(2,10-Nimbus.fnt)
%Fl(3,14-Rockbox-Mix.fnt)
%Fl(4,19-Nimbus.fnt)

%xl(a,hold.bmp,0,0)
%xl(b,play-status.bmp,0,0,7)
%xl(c,hdd-activity-wide.bmp,0,0)
%xl(d,batt-strip.bmp,0,0,17)
%xl(e,batt-charge-strip.bmp,0,0,8)
%xl(f,separator.bmp,0,0)
%xl(g,vol-bar-full.bmp,0,0)
%xl(h,vol-bar-empty.bmp,0,0)
%xl(i,vol-empty.bmp,0,0)
%xl(j,vol-full.bmp,0,0)
%xl(k,prohibited.bmp,0,0)

# --- LOGIC & CONDITIONAL TOGGLES ---
# Status & Top Bar Toggles
%Vd(TBMM)
%?if(%mp, !=, 1)<%Vd(PMS)>
%?mh<%Vd(hold)>
%?lh<%Vd(hdd)>
%?bp<%?bc<%Vd(charging)|%Vd(charged)>|%Vd(discharging)>

# Screen State Toggles (Lockscreen, Playback, USB, Info, Quickscreen)
%?if(%cs, =, 21)<%VI(u)%Vd(USB)|%?if(%cs, =, 16)<%VI(y)%Vd(ThemeInfo)|%?if(%cs, =, 10)<%VI(z)%Vd(QS)|%VI(x)>>>
%?if(%cs, =, 1)<%?mh<%?pS(0.2)<%?mp<|%Vd(rr)%Vd(LKN)>>>>
%?if(%cs, =, 1)<%?and(%if(%mh, =, 1), %if(%lh, =, 0))<%Vd(rr)%Vd(LKN)>>
%?if(%cs, =, 1)<%?mh<|%Vd(STU)>>

# --- GLOBAL UI ELEMENTS ---
# Top Separator
%V(0,14,160,1,-)%Vf(0)%Vb(3)
%xd(f)

# Menu Viewports (x = Main, y = Theme Info, z = Quickscreen, u = USB)
%Vi(x,0,22,160,106,-)%Vf(0)%Vb(3)
%Vi(y,0,22,160,90,-)%Vf(0)%Vb(3)
%Vi(z,0,20,160,76,-)%Vf(0)%Vb(3)
%Vi(u,0,0,0,0,-)
%Vl(rr,0,22,160,106,-)

# --- TOP BAR VIEWPORTS ---
# Play Mode Status
%Vl(PMS,2,3,10,10,-)%Vf(0)%Vb(3)
%?mp<%xd(ba)|%xd(bb)|%xd(bc)|%xd(bd)|%xd(be)|%xd(bf)|%xd(bg)>

# Hold Icon
%Vl(hold,16,2,8,10,-)%Vf(0)%Vb(3)
%xd(a)

# HDD Activity
%Vl(hdd,28,4,9,7,-)%Vf(0)%Vb(3)
%xd(c)

# Title Texts
%Vl(TBMM,38,2,84,11,2)%Vf(0)%Vb(3)
%ac%s%?if(%cs, =, 10)<iPod|%?cs<iPod|%?mv(4)<%Sx(Now Playing)|%?bs<%bs|%?cf<%cH:%cM|%cl:%cM %cP>>>|%Sx(Recording)|%Sx(FM Radio)|%Lt|%Lt|%Lt|%Lt|%Lt|%Lt|%Lt|Set Option|%Lt|%Lt|%?if(%Lt, =,Context Menu)<Perform Action|%Lt>|%Lt|%Lt|%Lt|%Lt|%Lt|iPod>>

# Battery Icons
%Vl(charging,135,2,25,10,-)%Vf(0)%Vb(3)
%t(0.5)%xd(ea);%t(0.5)%xd(eb);%t(0.5)%xd(ec);%t(0.5)%xd(ed);%t(0.5)%xd(ee);%t(0.5)%xd(ef);%t(0.5)%xd(eg);%t(0.5)%xd(eh)
%Vl(charged,135,2,25,10,-)%Vf(0)%Vb(3)
%xd(eh)
%Vl(discharging,135,2,25,10,-)%Vf(0)%Vb(3)
%?bl<%xd(da)|%xd(db)|%xd(dc)|%xd(dd)|%xd(de)|%xd(df)|%xd(dg)|%xd(dh)|%xd(di)|%xd(dj)|%xd(dk)|%xd(dl)|%xd(dm)|%xd(dn)|%xd(do)|%xd(dp)|%xd(dq)|%xd(dq)>

# --- SPECIFIC SCREEN VIEWPORTS ---
# Lockscreen No Album Art (LKN)
%Vl(LKN,0,40,160,25,4)%Vf(0)%Vb(3)
%ac%s%?cf<%cH:%cM|%cl:%cM %cP>
%Vl(LKN,0,60,160,25,2)%Vf(0)%Vb(3)
%ac%s%?if(%ss(0,7,%St(lang)), =, english)<%?cu<Monday|Tuesday|Wednesday|Thursday|Friday|Saturday|Sunday>|%ca>
%ac%s%?or(%if(%ss(0,7,%St(lang)), =, chinese),%if(%St(lang), =, magyar),%if(%St(lang), =, lietuviu),%if(%St(lang), =, japanese),%if(%St(lang), =, korean))<%cY %cb %ce|%?if(%St(lang), =, english-us)<%cb %ce %cY|%ce %cb %cY>>
%Vl(LKN,0,85,160,12,2)%Vf(0)%Vb(3)
%?bs<%ac%s%bs|>

# Scroll To Unlock (STU)
%Vl(STU,0,22,160,106,2)%Vf(0)%Vb(3)
%ac
%ac
%ac
%ac%sScroll To Unlock

# Quickscreen Volume Layout (QS)
%Vl(QS,0,97,160,1,-)%Vf(0)%Vb(3)
%xd(f)
%Vl(QS,6,100,9,12,-)%Vf(0)%Vb(3)
%xd(i)
%Vl(QS,19,102,122,8,-)%Vf(0)%Vb(3)
%pv(0,0,122,8,image,g,backdrop,h)
%Vl(QS,145,100,9,12,-)%Vf(0)%Vb(3)
%xd(j)
%Vl(QS,55,115,50,12,2)%Vf(0)%Vb(3)
%ac%pv dB

# USB Screen
%Vl(USB,55,30,50,50,-)%Vf(0)%Vb(3)
%xd(k)
%Vl(USB,0,90,160,20,2)%Vf(0)%Vb(3)
%acDo not disconnect.

# Theme Info Screen
%Vl(ThemeInfo,0,113,160,1,-)%Vf(0)%Vb(3)
%xd(f)
%Vl(ThemeInfo,0,116,160,12,2)%Vf(0)%Vb(3)
%acsprocket1Pod Mono v1